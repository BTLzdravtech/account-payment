<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_payment_pro.view_move_form"/>
        <field name="arch" type="xml">
            <button id="account_invoice_payment_btn" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'AR'"/>
            </button>
            <button id="account_invoice_payment_btn" position="after">
                <button name="action_force_register_payment" id="account_invoice_force_payment_btn_ar"
                    type="object" class="oe_highlight"
                    invisible="(
                        country_code != 'AR'
                        or state == 'cancel'
                        or payment_state not in ('not_paid', 'partial', 'in_payment')
                        or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')
                        or invoice_has_outstanding
                    )"
                    context="{'open_invoice_payment': True}"
                    string="Pay" data-hotkey="g"
                    groups="account.group_account_invoice"/>
            </button>
            <button id="account_invoice_payment_secondary_btn" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'AR'"/>
            </button>
            <button id="account_invoice_payment_secondary_btn" position="after">
                <button name="action_force_register_payment" id="account_invoice_force_payment_secondary_btn_ar"
                    type="object"
                    invisible="(
                        country_code != 'AR'
                        or state == 'cancel'
                        or payment_state not in ('not_paid', 'partial', 'in_payment')
                        or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')
                        or not invoice_has_outstanding
                    )"
                    context="{'open_invoice_payment': True}"
                    string="Pay" data-hotkey="g"
                    groups="account.group_account_invoice"/>
            </button>
        </field>
    </record>

</odoo>
